# =====================================================================
# E-Modul: template environment variable (AMAN di-commit, tanpa rahasia)
# Salin ke .env.local lalu isi nilainya. Jangan commit .env.local.
# Di Vercel, isi variabel yang sama lewat Project Settings > Environment Variables.
# =====================================================================

# --- Publik (boleh terlihat di browser; awalan VITE_ wajib agar dibaca Vite) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- RAHASIA: hanya untuk server (Vercel Functions) dan skrip lokal ---
# JANGAN pernah diberi awalan VITE_ dan JANGAN di-commit.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Rahasia pencampur hash PIN. Kehilangan/berganti = semua PIN siswa harus direset.
# Buat acak 64 hex dan SIMPAN CADANGAN di password manager.
PEPPER=
# Melindungi endpoint cron (/api/ping, /api/maintenance)
CRON_SECRET=

# --- Supabase CLI (migrasi) ---
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=
# Host pooler Supavisor (lihat Connect > Session pooler di dashboard)
SUPABASE_POOLER_HOST=aws-1-ap-southeast-1.pooler.supabase.com

# Penanda lingkungan (seed menolak berjalan bila bukan "development")
APP_ENV=development

# --- Opsional: batas laju sisi server (default di kode) ---
# Naikkan bila banyak siswa satu sekolah keluar internet lewat satu IP yang sama.
# RL_LOGIN_IP=60         # percobaan masuk per IP per 10 menit
# RL_REGISTER_IP=20      # pendaftaran per IP per jam
# RL_CLASS_CODE_IP=30    # percobaan kode kelas per IP per jam
# RL_LOGIN_NIS=30        # percobaan masuk per NIS per 10 menit
